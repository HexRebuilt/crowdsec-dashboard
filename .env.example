# CrowdSec Configuration
CROWDSEC_API_KEY=your_crowdsec_api_key_here

# Authentication (choose one method)
# Method 1: Username/Password
# If AUTH_PASSWORD is not set or is a default value, a random password
# will be generated and printed to the container logs on first run
AUTH_USERNAME=admin
# AUTH_PASSWORD=your_secure_password_here

# Method 2: Auth0/Authentik SSO (disables password login)
# AUTH0_DOMAIN=your-tenant.auth0.com
# AUTH0_CLIENT_ID=your_client_id
# AUTH0_CLIENT_SECRET=your_client_secret

# Notification settings
NOTIFY_ON_BAN=true
NOTIFY_ON_ALERT=true
ALERT_THRESHOLD=5
BAN_THRESHOLD=0
NOTIFY_COOLDOWN=3600
DIGEST_INTERVAL=0

# Apprise Configuration (choose one)
# Method 1: Embedded Apprise
APPRISE_URLS=mailto://user:password@host,telegram://bot_token/chat_id

# Method 2: Apprise API
# APPRISE_API_URL=http://apprise-api:8000
# APPRISE_API_KEY=your_apprise_api_key
